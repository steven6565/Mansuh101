# ─── MANSU101 environment ────────────────────────────────────────────────
# Copy to .env on the VPS:  cp .env.example .env
# Generate a password hash-free secret below.

# Dashboard port (Express + Socket.IO, also serves the built frontend)
PORT=4000
NODE_ENV=production

# REQUIRED: dashboard password. Use a long random string.
APP_PASSWORD=change-me-to-a-long-random-password
# Set to true ONLY for local development (disables the login screen)
AUTH_DISABLED=false
# Login token lifetime in days
SESSION_TTL_DAYS=14

# Public origin, used for cookie `secure` detection behind Nginx / HTTPS.
# Leave empty for same-origin plain-HTTP access (e.g. local development).
PUBLIC_URL=
# PUBLIC_URL=https://mansu101.example.com
TRUST_PROXY=1

# ─── Storage ─────────────────────────────────────────────────────────────
# SQLite by default (node:sqlite, zero native build). Stored under ./data.
DATABASE_URL=sqlite:./data/mansu101.db
# PostgreSQL (optional). Uncomment and install the `pg` package:
# DATABASE_URL=postgres://mansu:secret@127.0.0.1:5432/mansu101
# DATA_DIR=./data

# How many days of run history / events to retain
RETENTION_DAYS=30

# ─── Browser engine ──────────────────────────────────────────────────────
# Path to system Chromium. Leave empty to auto-detect common locations.
CHROMIUM_PATH=
# Browser mode. `true` = headless. `false` requires Xvfb + a desktop/VNC.
BROWSER_HEADLESS=true
# Required only for visible mode — Xvfb display created by deploy/vnc-setup.sh
# DISPLAY=:99
# Hard ceiling for concurrent browser tabs/sessions (VPS safety limit)
MAX_CONCURRENCY=8
# Close Chromium automatically when idle this long (frees RAM)
BROWSER_IDLE_CLOSE_MS=180000
# Extra Chromium flags, comma separated
CHROMIUM_EXTRA_ARGS=

# Optional remote desktop (noVNC / x11vnc web URL). Shown as embedded panel.
# e.g. https://vnc.example.com/vnc.html?autoconnect=1&resize=scale
VNC_URL=

# Optional Redis. Not required for a single-VPS deployment; the current
# single-process engine does not use it unless you add a multi-node adapter.
# REDIS_URL=redis://127.0.0.1:6379
