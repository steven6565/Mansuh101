# ─── Visitor · Organic SEO & Site Growth platform ────────────────────────
# Copy to .env before first run:   cp .env.example .env
# Never commit .env — it holds your dashboard password and OAuth secrets.

# ─── Server ──────────────────────────────────────────────────────────────
# Port for the Express API + built dashboard (Socket.IO shares it).
PORT=4000
NODE_ENV=production

# Where this instance runs. Only defaults differ between modes — every feature
# works in all three:
#   vps     a Linux server behind Nginx + PM2, binds 0.0.0.0
#   local   a desktop/laptop, binds 127.0.0.1
#   termux  Android via Termux (no root), binds 127.0.0.1
# Leave empty to auto-detect (Termux → termux, NODE_ENV=production → vps,
# otherwise local). The start scripts set it for you.
DEPLOYMENT_MODE=
# Bind address override. Empty = the mode default. Set 0.0.0.0 only when you
# really want to expose the dashboard to your network.
HOST=

# REQUIRED: dashboard password. Use a long random string (32+ chars):
#   openssl rand -base64 32
APP_PASSWORD=change-me-to-a-long-random-password
# true ONLY for local development — disables the login screen entirely.
AUTH_DISABLED=false
# Login session lifetime, in days.
SESSION_TTL_DAYS=14

# Public origin (no trailing slash). Used for OAuth redirects, secure-cookie
# detection and report links. Set this to your https domain in production.
PUBLIC_URL=
# PUBLIC_URL=https://seo.example.com
TRUST_PROXY=1

# ─── Storage ─────────────────────────────────────────────────────────────
# SQLite by default (node:sqlite — no native build step). Paths are relative
# to the project root unless absolute.
DATABASE_URL=sqlite:./data/visitor.db
# PostgreSQL (optional):
# DATABASE_URL=postgres://visitor:secret@127.0.0.1:5432/visitor
DATA_DIR=./data

# How many days of Google metrics, audit records and events to keep.
RETENTION_DAYS=90

# ─── Google Search Console + GA4 (OAuth 2.0) ─────────────────────────────
# Create an OAuth 2.0 "Web application" client in Google Cloud Console,
# enable "Google Search Console API" and "Google Analytics Data API", then
# add this exact redirect URI to the client:
#   https://YOUR_DOMAIN/api/integrations/google/callback
# Leave blank to run without Google — every screen then says "not connected"
# instead of inventing numbers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Search Console finalises data 2-3 days late. How many days to subtract from
# the end of every GSC window (0 = include yesterday).
GSC_DATA_LAG_DAYS=1
# Optional: Chrome UX Report API key for real Core Web Vitals field data.
GOOGLE_API_KEY=

# Key used to encrypt OAuth refresh tokens at rest (AES-256-GCM).
# Generate one with:  openssl rand -base64 32
# If empty, a key is generated once and stored in data/.secrets.json (0600).
TOKEN_ENCRYPTION_KEY=

# ─── Crawler / technical audit ───────────────────────────────────────────
# Identifies your crawler. Keep a real contact URL — sites you audit can see it.
CRAWLER_USER_AGENT=VisitorSEO/2.0 (+https://your-domain.example; authorized SEO audit)
# Hard caps. MAX_AUDIT_PAGES also caps the per-run setting in the UI.
MAX_AUDIT_PAGES=25
CRAWLER_CONCURRENCY=3
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_BYTES=3000000
# Allow crawling private/loopback addresses. Local development only —
# this disables the SSRF guard.
CRAWLER_ALLOW_PRIVATE=false

# ─── Scheduler (recurring syncs, audits, reports) ────────────────────────
SCHEDULER_ENABLED=true
# How often to check for due jobs, in milliseconds (min 10000).
SCHEDULER_TICK_MS=30000
# Retries per job before it is marked failed (0-5).
SCHEDULER_MAX_RETRIES=2
# Timezone used for daily/weekly report windows.
REPORT_TIMEZONE=UTC
# Optional webhook (Slack/Discord/generic) called when a job exhausts retries.
ALERT_WEBHOOK_URL=

# ─── Email delivery for reports (optional) ───────────────────────────────
# Without these, report export works but "Email" stays disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─── Security ────────────────────────────────────────────────────────────
# Per-IP request budgets per minute (read vs write/expensive endpoints).
RATE_LIMIT_PER_MINUTE=300
EXPENSIVE_RATE_LIMIT_PER_MINUTE=12
# Reject state-changing requests whose Origin header does not match the host.
CSRF_ORIGIN_CHECK=true

# ─── Rendered audits (optional, needs Chromium) ──────────────────────────
# Path to a Chromium/Chrome binary. Empty = auto-detect common locations.
CHROMIUM_PATH=
BROWSER_HEADLESS=true
# Close the browser automatically after this idle period (frees RAM).
BROWSER_IDLE_CLOSE_MS=120000
# Extra Chromium flags, comma separated.
CHROMIUM_EXTRA_ARGS=
# Ceiling for concurrent browser contexts.
MAX_CONCURRENCY=4
