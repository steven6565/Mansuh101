{
  "name": "visitor-seo",
  "version": "2.0.0",
  "private": true,
  "description": "Visitor — organic SEO and website growth management for sites you own (Search Console, GA4, technical audits, keywords, content, campaigns, reports)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:server": "pnpm --dir server dev",
    "dev:web": "pnpm --dir web dev",
    "build": "pnpm --dir web build",
    "start": "node server/src/index.js",
    "local": "node scripts/visitorctl.mjs start --mode=local",
    "termux": "node scripts/visitorctl.mjs start --mode=termux",
    "stop": "node scripts/visitorctl.mjs stop",
    "restart": "node scripts/visitorctl.mjs restart",
    "status": "node scripts/visitorctl.mjs status",
    "logs": "node scripts/visitorctl.mjs logs",
    "setup": "pnpm install && pnpm build",
    "test": "node server/scripts/selftest.js",
    "test:sqlite": "node server/scripts/selftest.js --sqlite",
    "doctor": "node server/scripts/doctor.js",
    "preflight": "node server/scripts/doctor.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
